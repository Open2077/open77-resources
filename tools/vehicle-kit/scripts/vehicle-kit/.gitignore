# Generated by build-pack.ps1 or by running the Blender scripts by hand. The default
# output folder is <repo>/artifacts/vehicle-kit/, already ignored at the root; these
# entries cover a manual run into this folder. Never commit a cooked or extracted
# file: the work tree also holds the read-only game templates.
__pycache__/
out/
work/
preview/
*.glb
*.blend
*.blend1
*.mesh
*.w2mesh
*.ent
*.mi
*.archive
*.zip
*.png
